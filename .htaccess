# =========================================================
# TeamOnTime Production Configuration
# =========================================================

Options -Indexes

DirectoryIndex index.html

<IfModule mod_rewrite.c>

RewriteEngine On

# =========================================================
# 1. FORCE HTTPS + NON-WWW IN A SINGLE REDIRECT
# =========================================================

RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^teamontime\.com$ [NC]

RewriteRule ^ https://teamontime.com%{REQUEST_URI} [R=301,L]


# =========================================================
# 2. REMOVE /index OR /index.html
# =========================================================

RewriteCond %{THE_REQUEST} \s/+(.*/)?index(?:\.html)?[\s?] [NC]

RewriteRule ^(.*/)?index(?:\.html)?$ /$1 [R=301,L]


# =========================================================
# 2.5 INTERNAL PROTECTION & HISTORICAL REDIRECTS (PRE-STRIP)
# =========================================================

# Block access to internal directories and development artifacts
RewriteRule ^(_internal|docs|reports|scripts)(/.*)?$ - [F,L]
RewriteRule \.(md|py|csv|sample)$ - [F,L]

# P0 Shopify Content Consolidation Redirects (Single-Hop 301, no chains)
RewriteRule ^blog/white-label-shopify-development-vs-in-house-developers/?$ /blog/in-house-vs-freelancer-vs-white-label-shopify-development [R=301,L]
RewriteRule ^blog/white-label-shopify-development-vs-in-house-developers\.html$ /blog/in-house-vs-freelancer-vs-white-label-shopify-development [R=301,L]
RewriteRule ^blog/why-agencies-choose-white-label-shopify-developers-instead-of-hiring-in-house-teams/?$ /blog/in-house-vs-freelancer-vs-white-label-shopify-development [R=301,L]
RewriteRule ^blog/why-agencies-choose-white-label-shopify-developers-instead-of-hiring-in-house-teams\.html$ /blog/in-house-vs-freelancer-vs-white-label-shopify-development [R=301,L]
RewriteRule ^blog/why-agencies-outsource-shopify-development/?$ /blog/in-house-vs-freelancer-vs-white-label-shopify-development [R=301,L]
RewriteRule ^blog/why-agencies-outsource-shopify-development\.html$ /blog/in-house-vs-freelancer-vs-white-label-shopify-development [R=301,L]
RewriteRule ^blog/why-growing-agencies-choose-white-label-shopify-development/?$ /blog/how-agencies-scale-from-10-to-100-shopify-clients-with-white-label-development [R=301,L]
RewriteRule ^blog/why-growing-agencies-choose-white-label-shopify-development\.html$ /blog/how-agencies-scale-from-10-to-100-shopify-clients-with-white-label-development [R=301,L]
RewriteRule ^blog/why-the-best-shopify-agencies-never-hire-developers-for-every-new-client/?$ /blog/how-white-label-shopify-development-improves-agency-profit-margins [R=301,L]
RewriteRule ^blog/why-the-best-shopify-agencies-never-hire-developers-for-every-new-client\.html$ /blog/how-white-label-shopify-development-improves-agency-profit-margins [R=301,L]

# Legacy URL Redirects (must precede .html stripping to prevent 2-hop chains)
RewriteRule ^white-label-shopify-development/?$ /shopify-white-label [R=301,L]
RewriteRule ^white-label-shopify-development\.html$ /shopify-white-label [R=301,L]
RewriteRule ^shopify-development/?$ /shopify-white-label [R=301,L]
RewriteRule ^shopify-development\.html$ /shopify-white-label [R=301,L]
RewriteRule ^seo-fulfillment/?$ /search-engineering [R=301,L]
RewriteRule ^seo-fulfillment\.html$ /search-engineering [R=301,L]
RewriteRule ^wordpress-delivery/?$ /wordpress-white-label [R=301,L]
RewriteRule ^wordpress-delivery\.html$ /wordpress-white-label [R=301,L]
RewriteRule ^partner-program/?$ /agency-partner [R=301,L]
RewriteRule ^partner-program\.html$ /agency-partner [R=301,L]
RewriteRule ^blog/how-white-label-wordpress-development-helps-agencies-scale-without-hiring/?$ /blog/why-agencies-outsource-wordpress-development [R=301,L]
RewriteRule ^blog/how-white-label-wordpress-development-helps-agencies-scale-without-hiring\.html$ /blog/why-agencies-outsource-wordpress-development [R=301,L]


# =========================================================
# 3. REMOVE .html FROM PUBLIC URLS
# =========================================================

RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]

RewriteRule ^(.+?)\.html$ /$1 [R=301,L]


# =========================================================
# 4. INTERNAL CLEAN URL → HTML FILE REWRITE
# =========================================================

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

RewriteCond %{REQUEST_FILENAME}.html -f

RewriteRule ^(.+?)/?$ $1.html [END]

</IfModule>


# =========================================================
# CUSTOM 404
# =========================================================

ErrorDocument 404 /404.html


# =========================================================
# SECURITY HEADERS
# =========================================================

<IfModule mod_headers.c>

Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

Header always set X-Content-Type-Options "nosniff"

Header always set X-Frame-Options "SAMEORIGIN"

Header always set Referrer-Policy "strict-origin-when-cross-origin"

Header always set Permissions-Policy "accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), speaker-selection=(), usb=(), web-share=(self), xr-spatial-tracking=()"

Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://assets.calendly.com https://cdn.jsdelivr.net https://www.googletagmanager.com https://ssl.google-analytics.com https://www.google-analytics.com https://analytics.google.com https://www.clarity.ms https://cdn.clarity.ms https://c.clarity.ms https://scripts.clarity.ms; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://images.unsplash.com https://www.google-analytics.com https://www.googletagmanager.com https://www.clarity.ms https://c.clarity.ms https://c.bing.com https://teamontime.com; connect-src 'self' https://api.emailjs.com https://calendly.com https://*.calendly.com https://www.google-analytics.com https://analytics.google.com https://stats.g.doubleclick.net https://region1.google-analytics.com https://region1.analytics.google.com https://www.googletagmanager.com https://*.clarity.ms https://c.bing.com; frame-src 'self' https://calendly.com https://*.calendly.com https://www.googletagmanager.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"

Header always unset X-Powered-By

Header always unset Server

</IfModule>


# =========================================================
# COMPRESSION
# =========================================================

<IfModule mod_deflate.c>

AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/xml application/ld+json image/svg+xml font/woff font/woff2

</IfModule>


# =========================================================
# CACHE
# =========================================================

<IfModule mod_expires.c>

ExpiresActive On

ExpiresByType text/html "access plus 0 seconds"

ExpiresByType text/css "access plus 1 year"

ExpiresByType application/javascript "access plus 1 year"

ExpiresByType image/png "access plus 1 year"

ExpiresByType image/jpeg "access plus 1 year"

ExpiresByType image/webp "access plus 1 year"

ExpiresByType image/svg+xml "access plus 1 year"

ExpiresByType image/gif "access plus 1 year"

ExpiresByType image/x-icon "access plus 1 year"

ExpiresByType font/woff "access plus 1 year"

ExpiresByType font/woff2 "access plus 1 year"

</IfModule>


<IfModule mod_headers.c>

<FilesMatch "\.(css|js|png|jpg|jpeg|gif|svg|webp|woff|woff2|ico)$">

Header set Cache-Control "public, max-age=31536000, immutable"

</FilesMatch>

</IfModule>


# =========================================================
# MIME TYPES
# =========================================================

<IfModule mod_mime.c>

AddType application/manifest+json .webmanifest

AddType font/woff .woff

AddType font/woff2 .woff2

AddType image/webp .webp

AddType application/ld+json .jsonld

</IfModule>


# =========================================================
# PROTECT SENSITIVE FILES
# =========================================================

<FilesMatch "(^\.htaccess|^\.env|^\.git|composer\.lock|package\.json|package-lock\.json)$">

Require all denied

</FilesMatch>